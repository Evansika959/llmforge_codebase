# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
build/
dist/

# Scratch space for temporary files (never committed)
/scratch/

# Experiment working directories (large, regenerable; experiments run inside this repo)
/runs/
/runs_v2/
/logs/
/data/
/checkpoints/
/timeloop_cache/
/outputs/
*.safetensors
*.pt
wandb/

# Local machine configuration (hosts, keys, device serials) never enters the repo
/configs/local/
*.hosts.yaml

.DS_Store

# Working checkouts and build trees of external projects. The parts this project needs are vendored
# under vendor/ instead, so nothing here ships.
/third_party/

# Build products of the vendored device runtime
/vendor/device_runtime/run*
!/vendor/device_runtime/run*.c
!/vendor/device_runtime/run*.ipynb
*.o
